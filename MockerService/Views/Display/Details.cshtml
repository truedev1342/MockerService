@*
*@
@{
    ViewData["Title"] = "Mocker";
    var pageData = ViewData["pageData"];
    var projectData = ViewData["projectData"];
    var Pages = ViewData["Pages"];
    string mainPage = (string)ViewData["MainPage"];
}

<div id="wrapper" class="h-100">
    <div class="sidebar-toggle-btn" id="btnToolbar" title="Hide toolbar"> 
        <a href="javascript:toggleSidebar();"><i class="fas fa-bars"></i></a>
    </div>
    
    <!-- Sidebar -->
    <div id="mainSidebar">
        <ul class="navbar-nav sidebar sidebar-dark accordion" id="accordionSidebar">
            
            <!-- Divider -->
            <hr class="sidebar-divider"/>
            <li class="nav-item" id="itemHome">
                <div class="btn-circle" id="iconHome" title="Go to starting point">
                    <a class="nav-link" href="javascript: toggleIcon(1);"><i class="fa fa-home"></i></a>
                </div>
                
            </li>
            <li class="nav-item" id="itemTable">
                <div class="btn-circle" id="iconTable" title="Show table of contents">
                    <a class="nav-link" href="javascript: toggleIcon(2);"><i class="fas fa-table"></i></a>
                </div>
            </li>
            <li class="nav-item" id="itemComment">
                <div class="btn-circle" id="iconComment" title="Show comments">
                    <a class="nav-link" href="javascript: toggleIcon(3);"><i class="fas fa-comment-dots"></i></a>
                </div>
            </li>
            <hr class="sidebar-divider"/>
            <li class="nav-item" id="itemHighlight">
                <div class="btn-circle" id="iconHighlight" title="Turn ON interaction highlight">
                    <a class="nav-link" href="javascript: toggleHighlight();"><i class="fas fa-fw fa-compass"></i></a>
                </div>
            </li>
            <li class="nav-item" id="itemDesign">
                <div class="btn-circle" id="iconDesign" title="Turn ON design annotations">
                    <a class="nav-link" href="javascript: toggleDesign();"><i class="fas fa-fw fa-file"></i></a>
                </div>
            </li>
            <hr class="sidebar-divider"/>
            <li class="nav-item" style="position:absolute; bottom:0px">
                <div class="btn-circle">
                    <a class="nav-link" href="#"><i class="fas fa-user-circle"></i></a>
                </div>
            </li>
        </ul>
    </div>
    
    <!-- End of Sidebar -->


    <!-- Content Wrapper -->
    <div id="content-wrapper" class="d-flex flex-column">
        <!-- Main Content -->
        <div id="content" class="h-100" >
            <!-- Begin Page Content -->
            <div class="row h-100 px-2">
                <div class="col-3 bg-white border-right" id="paneTable">
                    <div class="row bg-gray-200 px-4 py-2">
                        <input type="text" class="w-100" placeholder="Search screens..." />
                    </div>
                    @foreach (var item in @Pages as List<string>)
                    {
                        @if (item == mainPage)
                        {
                            <div class="row py-2">
                                <div class="card w-100 mx-2 p-2" onclick="drawPage('@item')">
                                    <h7 class="card-title" style="color:blue;">@item</h7>
                                    @{
                                        var imgStr = @ViewData["baseURL"] + "/uploads/" + @ViewData["path"] + "/screenshots/" + @item + ".png";
                                    }
                                    <img src='@imgStr' class="card-img" alt="...">
                                    <div class="m-2"  style="position:absolute; right:0px; bottom:0px;color:#4b6dcf;">
                                        <i class="fa fa-home"></i>
                                    </div>
                                </div>
                            </div>
                        } else
                        {
                            <div class="row py-2">
                                <div class="card w-100 mx-2 p-2" onclick="drawPage('@item')">
                                    <h7 class="card-title" style="color:blue;">@item</h7>
                                    @{
                                        var imgStr = @ViewData["baseURL"] + "/uploads/" + @ViewData["path"] + "/screenshots/" + @item + ".png";
                                    }
                                    <img src='@imgStr' class="card-img" alt="...">
                                </div>
                            </div>     
                        }

                    }
                </div>
                <div class="col-9 h-100" id="pageContent">
                
                </div>
            </div>
            <!-- /.container-fluid -->
        </div>
        <!-- End of Main Content -->
    </div>
    <!-- End of Content Wrapper -->
</div>
@section Scripts {
    <script>
        var project;
        var page;
        var current_page = "";

        function commonStyle(ob) {
            var style = "position: absolute; ";
            if ('x' in ob) style += "left: " + ob.x + "px;";
            if ('y' in ob) style += "top: " + ob.y + "px;";
            if ('w' in ob) style += "width: " + ob.w + "px;";
            if ('h' in ob) style += "height: " + ob.h + "px;";
            if ('Background' in ob) style += "background: " + ob.Background + ";";
            if ('BorderColor' in ob) style += "border-color: " + ob.BorderColor + ";";
            if ('BorderRound' in ob) {
                style += "border-top-left-radius: " + ob.BorderRound.TopLeft + "px;";
                style += "border-top-right-radius: " + ob.BorderRound.TopRight + "px;";
                style += "border-bottom-right-radius: " + ob.BorderRound.BottomRight + "px;";
                style += "border-bottom-left-radius: " + ob.BorderRound.BottomLeft + "px;";
            }
            if ('BorderThickness' in ob) {
                style += "border-top-width: " + ob.BorderThickness.Top + "px;";
                style += "border-bottom-width: " + ob.BorderThickness.Bottom + "px;";
                style += "border-left-width: " + ob.BorderThickness.Left + "px;";
                style += "border-right-width: " + ob.BorderThickness.Right + "px;";
            }
            if ('Foreground' in ob) style += "color: " + ob.Foreground + ";";
            if ('Opacity' in ob) style += "opacity: " + ob.Opacity + ";";
            if ('fontSize' in ob) style += "font-size: " + ob.fontSize + "px;";
            if ('fontFamily' in ob) style += "font-family: '" + ob.fontFamily.Name + "';";
            return style;
        }

        function getImageByDevice(device) {
            if (device == "iPhone 7") {
                return '@ViewData["baseURL"]/img/iphone7-portrait.svg';
            }
            if (device == "iPhone 7 Landscape") {
                return '@ViewData["baseURL"]/img/iphone7-landscape.svg';
            }
            return "";
        }

        function getDivByDevice(device, bg) {
            if (device == "iPhone 7") {
                return '<div style="height: 77%; margin-top:24%; margin-left: 6%; margin-right: 6%; margin-bottom: 24%; position: relative; background-color: ' + bg + '" >';
            }
            if (device == "iPhone 7 Landscape") {
                return '<div style="height: 88%; margin-top:3%; margin-left: 12%; margin-right: 12%; margin-bottom: 3%; position: relative; background-color: ' + bg + '" >';
            }
            return '<div style="height: 12%"></div><div style="height: 76%; margin-left: 7%; margin-right: 6%; position: relative; background-color: ' + bg + '" >';
        }

        function drawPage(p) {
            if (p == "") return;
            if (p == null) return;
            if (p == "NULL") return;
            current_page = p;
            var html = "";
            var imgURL = getImageByDevice(project.Device);
            
            html += '<div class="mx-auto my-auto" style="width:' + project.size.W + 'px; height:' + project.size.H + 'px; background:url(\'' + imgURL + '\'); background-size: ' + project.size.W + 'px ' + project.size.H + 'px; background-repeat:no-repeat">';

            var curPage = null;
            for (var i in page) {
                if (page[i].pageTitle == p) {
                    curPage = page[i];
                    break;
                }
            }
            html += getDivByDevice(project.Device, curPage.background);
            var content = curPage.Contents;
            for (var i in content) {
                if (content[i].Name == "Button") {
                    var style = commonStyle(content[i]);
                    html += '<input type = "button" value="' + content[i].Text + '" onclick = "drawPage(\'' + content[i].TapEvent + '\');") ondblclick="drawPage(\'' + content[i].DTapEvent + '\');" style = "' + style + '"/>';
                }

                if (content[i].Name == "TextBox") {
                    var style = commonStyle(content[i]);
                    if ('isBold' in content[i] && content[i].isBold == true ) style += "font-weight: bold;";
                    if ('isItalic' in content[i] && content[i].isItalic == true) style += "font-style: italic;";

                    html += '<input type = "text" value = "' + content[i].Text + '" style = "' + style + '"/>';
                }

                if (content[i].Name == "Label") {
                    var style = commonStyle(content[i]);
                    if ('isBold' in content[i] && content[i].isBold == true ) style += "font-weight: bold;";
                    if ('isItalic' in content[i] && content[i].isItalic == true) style += "font-style: italic;";

                    html += '<Label style = "' + style + '">' + content[i].Text + '</Label>';
                }
            }
            html += '</div></div>';
            $("#pageContent").html(html);
        }
        $(document).ready(function() {
            project = @Html.Raw(@projectData);
            page = @Html.Raw(@pageData);
            current_page = project.MainPage;
            drawPage(project.MainPage);
            toggleIcon(1);
        });
    </script>
}
