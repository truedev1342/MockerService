@*
    
*@
@{
    ViewData["Title"] = "Mocker";
}

<style>
    .imgBG {
        background-image:url('@ViewData["imgURL"]');
        background-repeat:no-repeat;
        background-size:cover;
    }
</style>

<div id="wrapper" class="h-100">
    <!-- Content Wrapper -->
    <div id="content-wrapper" class="d-flex flex-column">
        <!-- Main Content -->
        <div id="content">
            <!-- Begin Page Content -->
            <div class="container-fluid px-0 h-100">
                <!-- Content Row -->
                <div class="row h-100">
                    <div class="col-6 px-0">
                        <div class="filters shadow rounded bg-white mb-3 d-none d-sm-none d-md-block h-100">
                            <div class="h-25"></div>
                            <div class="row">
                                <h1 class="text-center mx-auto text-black">Screen</h1>
                            </div>
                            <div class="row">
                                <div class="col-6 text-right">
                                    <label class="bg-success rounded-circle">&nbsp;HJ&nbsp;</label>
                                </div>
                                <div class="col-6 pl-0">
                                    <label>@ViewData["designer_name"]</label>
                                </div>
                            </div>
                            <div class="row">
                                <button class="btn bg-success mx-auto text-white rounded-pill">RUN PROTOTYPE</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 px-0">
                        <div style="height:15%"></div>
                        <div class="row h-75">
                            <div class="col-2"></div>
                            <div class="col-8 shadow border-0 bg-white rounded-0 imgBG">
                                <div class="row" style="height:40%"></div>
                                <div class="row">
                                    <button class="btn bg-success text-white mx-auto rounded-circle p-2" onclick="gotoDetails()">Play</button>
                                </div>
                            </div>
                            <div class="col-2"></div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- /.container-fluid -->
        </div>
        <!-- End of Main Content -->
    </div>
    <!-- End of Content Wrapper -->
</div>
@section Scripts {
    <script>
        function gotoDetails() {
            var url = '@ViewData["baseURL"]/display/details/@ViewData["path"]';
            window.location.href=url;
        }
    </script>
}